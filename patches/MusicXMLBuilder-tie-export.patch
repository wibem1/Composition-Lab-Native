+        // der gebundenen Folgenoten; Pitch/Staff begrenzen die Zuordnung.
+        let explicitTieStart = events.contains { ev in
+            guard ev.t.lowercased() == "tie", abs(ev.b - f.sourceStart) < 0.000_1 else { return false }
